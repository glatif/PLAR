# Copy to server/.env.local (git-ignored) to override the defaults. No secrets here:
# the harness uses SSH key login only.
# The team's project server (OVH, managed with `hz`):
PLAR_SERVER_HOST=144.217.80.160
PLAR_SERVER_USER=hh_horaizon
PLAR_SERVER_KEY=$HOME/.ssh/id_ed25519
PLAR_DOMAIN=plar.airl.ca
# The older IONOS server can still be inspected with:
#   PLAR_SERVER_HOST=74.208.142.195 PLAR_SERVER_USER=root ./inspect.sh
# Identity-verification lab on the live site (/verify, /testing). Open to anyone until sign-in is added.
# PLAR_LAB_AI=true also sends OPENROUTER_API_KEY and VERIFICATION_AI_MODEL from web/.env.local.
PLAR_LAB=true
PLAR_LAB_AI=true
# Demo sign-in on the live site (synthetic accounts only): one-click demo accounts and the Microsoft
# demo picker. Sends DEMO_LOGIN_PASSWORD from web/.env.local. PLAR_MICROSOFT: demo, entra or off.
PLAR_DEMO=true
PLAR_MICROSOFT=demo
