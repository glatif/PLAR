# PLAR's own Supabase on the OVH server (the default target). The key is the public anon key:
# get it with `server/plar-api.sh anon-key`.
PLAR_SERVER_URL=https://plar-api.airl.ca
PLAR_SERVER_PUBLISHABLE_KEY=

# Copy to .env.local (git-ignored). Never commit real secrets.

# Hosted development project (Supabase, Canada Central). The publishable key is public by design.
PLAR_DEV_URL=https://dxnurogvpdxtbaocallr.supabase.co
PLAR_DEV_PUBLISHABLE_KEY=sb_publishable_...

# Only needed for `npm run dev:seed`: the dev database connection string (Supabase dashboard → Connect →
# Session pooler). It contains the database password, so keep it in .env.local only.
# PLAR_DEV_DB_URL=

# Only needed for dev:link, dev:push and `npm run types` against dev.
# Prefer running `supabase login` once instead of setting this.
# SUPABASE_ACCESS_TOKEN=
