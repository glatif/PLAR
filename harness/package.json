{
  "name": "plar-supabase-harness",
  "private": true,
  "type": "module",
  "description": "Configure and test the PLAR Supabase backend (the hosted dev project).",
  "scripts": {
    "doctor": "tsx src/doctor.ts",
    "check": "tsx src/check.ts --target dev",
    "dev:seed": "node --env-file=.env.local -e \"const u=process.env.PLAR_DEV_DB_URL; if(!u){console.error('Set PLAR_DEV_DB_URL in harness/.env.local first.');process.exit(1)} require('node:child_process').execFileSync('psql',[u,'-v','ON_ERROR_STOP=1','-q','-f','../supabase/seed.sql'],{stdio:'inherit'})\"",
    "types": "tsx src/types.ts --target dev",
    "dev:link": "supabase link --project-ref dxnurogvpdxtbaocallr --workdir ..",
    "dev:migrations": "supabase migration list --linked --workdir ..",
    "dev:push": "supabase db push --linked --workdir ..",
    "db:new": "supabase migration new --workdir ..",
    "db:lint": "supabase db lint --workdir ..",
    "typecheck": "tsc --noEmit",
    "test": "npm run check",
    "check:local": "tsx src/check.ts --target local",
    "types:local": "tsx src/types.ts --target local",
    "local:start": "supabase start --workdir ..",
    "local:stop": "supabase stop --workdir ..",
    "local:status": "supabase status --workdir ..",
    "local:env": "supabase status --workdir .. -o env --override-name api.url=NEXT_PUBLIC_SUPABASE_URL --override-name auth.publishable_key=NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "local:reset": "supabase db reset --workdir ..",
    "test:db": "supabase test db --workdir .."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
