# Copy to .env.local (git-ignored). Public values only: never put secret or service keys here.

# Hosted development project (Supabase, Canada Central)
NEXT_PUBLIC_SUPABASE_URL=https://dxnurogvpdxtbaocallr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local stack instead (run `npm run local:start` in harness/, then `npm run local:env` for the values)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# One-click demo sign-in on /sign-in (hosted dev only, synthetic accounts). Leave unset anywhere else.
# DEMO_LOGIN_PASSWORD=

# "Sign in with Microsoft": demo (a picker of the demo accounts; needs DEMO_LOGIN_PASSWORD), entra
# (TRU's Microsoft Entra ID through Supabase's Azure provider, once it's set up) or off.
# Unset means demo when DEMO_LOGIN_PASSWORD is set.
# MICROSOFT_SIGN_IN=demo

# Verification lab AI check (server-only). Leave unset to turn the AI check off.
# OPENROUTER_API_KEY=
# VERIFICATION_AI_MODEL=google/gemini-3.5-flash-lite
